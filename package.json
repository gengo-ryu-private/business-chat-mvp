{
  "name": "business-chat-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project business-chat-mvp-e2e \"vitest run --config vitest.rules.config.ts\"",
    "test:demo-cli": "firebase emulators:exec --only auth,firestore --project business-chat-mvp-e2e \"vitest run --config vitest.demo-cli.config.ts\"",
    "test:e2e": "firebase emulators:exec --project business-chat-mvp-e2e \"playwright test\"",
    "demo:check": "tsx scripts/demo-tenant.ts check",
    "demo:provision": "tsx scripts/demo-tenant.ts provision",
    "demo:reset": "tsx scripts/demo-tenant.ts reset",
    "demo:deprovision": "tsx scripts/demo-tenant.ts deprovision"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^1.14.0",
    "next": "16.3.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.26.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
